# Supabase public client values. The publishable key is only safe to expose if
# Row-Level Security is enabled on every table — confirm RLS before relying on it.
# Use placeholders here; put real values in an untracked .env (see .gitignore).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Database (backend) - DO NOT commit real credentials to version control
# Provide the full JDBC URL for Supabase Postgres, username and password via environment.
# SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<your-db-password>

# Optional JPA overrides
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
# SPRING_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
